# PORT: HTTP port for the Node.js Express + Vite server (default 3000)
PORT="3000"

# GEMINI_API_KEY: Required for Gemini AI API calls (injected at runtime if needed).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PROVIDER API CREDENTIALS (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
PROVIDER_API_URL="https://ffglory.pro"
PROVIDER_API_KEY=""
PROVIDER_MASTER_KEY=""
PROVIDER_USERNAME=""
PROVIDER_PASSWORD=""

# SESSION & ADMIN SECURITY (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SESSION_SECRET=""
ADMIN_USERNAME=""
ADMIN_EMAIL=""
ADMIN_ACCESS_KEY=""

# YOUTUBE DATA API V3 (SERVER-SIDE ONLY)
YOUTUBE_API_KEY=""

# OPTIONAL CLOUD FIRESTORE ADMIN PERSISTENCE (WORKS ON ANY NODE.JS HOST): Firebase Admin Service Account JSON
FIREBASE_SERVICE_ACCOUNT_JSON=""

# FAMWISE UPI PAYMENT GATEWAY (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
FAMWISE_BASE_URL="https://famwise.co"
FAMWISE_API_KEY=""
FAMWISE_UPI_ID=""
FAMWISE_WEBHOOK_SECRET=""
